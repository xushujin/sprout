{
  "name": "wordsprout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host localhost",
    "dev:api": "wrangler dev --ip localhost --port 8787 --test-scheduled",
    "setup": "node scripts/setup.mjs",
    "seed": "node scripts/seed.mjs",
    "secrets:production": "node scripts/production-secrets.mjs",
    "db:local": "wrangler d1 execute wordsprout --local --file schema.sql",
    "db:remote": "wrangler d1 execute wordsprout --remote --file schema.sql",
    "db:styles": "node scripts/migrate-owned-styles.mjs",
    "db:gifts": "node scripts/migrate-gift-points.mjs",
    "typecheck": "tsc -b",
    "build": "npm run check:vocabulary && npm run typecheck && vite build && node scripts/check-vocabulary.mjs --dist",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:layout": "playwright test -c playwright.layout.config.ts",
    "check:vocabulary": "node scripts/check-vocabulary.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:api": "wrangler deploy",
    "deploy:web": "wrangler pages deploy dist --project-name wordsprout",
    "predeploy:web": "npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "~4.1.12",
    "wrangler": "^4.158.0"
  }
}
